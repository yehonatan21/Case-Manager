# ─── Core ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME="Case Manager"
# Required in production: signs sessions/codes and derives the file-encryption key.
APP_SECRET=change-me-to-a-long-random-string
# Dates are displayed in this time zone everywhere.
NEXT_PUBLIC_TIME_ZONE=Asia/Jerusalem

# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL. Leave empty to use an embedded PGlite database in .data/pglite (development).
DATABASE_URL=
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/casemanager
AUTO_MIGRATE=true
# First admin account (created on an empty database).
ADMIN_EMAIL=admin@example.com
# Demo customers, staff and cases (defaults to true outside production).
SEED_DEMO_DATA=true

# ─── AI ──────────────────────────────────────────────────────────────────
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline engine.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_RUNS_PER_HOUR=120

# ─── Email ───────────────────────────────────────────────────────────────
# console = log emails and show sign-in codes on screen (development only).
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM="Case Manager <no-reply@example.com>"
DEV_MAILBOX=true

# ─── Payments ────────────────────────────────────────────────────────────
# mock = built-in test checkout; stripe = Stripe Checkout.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── File storage ────────────────────────────────────────────────────────
# local = encrypted files in .data/uploads; s3 = any S3-compatible bucket.
STORAGE_PROVIDER=local
STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=20
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Malware scanning via ClamAV (clamd). Without it, uploads are validated but not scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ─── Jobs ────────────────────────────────────────────────────────────────
# Protects POST /api/jobs/run (quote expiry + email outbox). Call it from cron.
CRON_SECRET=
