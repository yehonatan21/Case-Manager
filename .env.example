# ─── Core ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME="Case Manager"
# Required in production: signs sessions/codes and derives the file-encryption key. Keep it stable.
APP_SECRET=change-me-to-a-long-random-string
# Public demo: sign-in codes shown on screen, demo data seeded, warning banner. Never with real data.
DEMO_MODE=false
# Dates are displayed in this time zone everywhere.
NEXT_PUBLIC_TIME_ZONE=Asia/Jerusalem

# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL. Leave empty to use an embedded PGlite database in .data/pglite (development).
DATABASE_URL=
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/casemanager
AUTO_MIGRATE=true
# First admin account (created on an empty database).
ADMIN_EMAIL=admin@example.com
# Demo customers, staff and cases (defaults to true outside production).
SEED_DEMO_DATA=true

# ─── Google sign-in (optional) ───────────────────────────────────────────
# OAuth client from Google Cloud Console → APIs & Services → Credentials (type: Web application).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback. The button appears when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────
# AI provider: auto | anthropic | openrouter | openai-compatible | mock
# auto = the first one configured, in this order: Claude, OpenRouter, OpenAI-compatible; none = offline engine.
AI_PROVIDER=auto

# Claude (Anthropic). Also reads uploaded documents.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# OpenRouter (openrouter.ai): one key for many models, including free ones (":free").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Tried in order if the model above is down or rate-limited (comma-separated).
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# allow | deny. deny = only providers that don't store or train on prompts (most free models then unavailable).
OPENROUTER_DATA_COLLECTION=allow

# Any OpenAI-compatible API (OpenAI, Groq, Mistral, Together, local Ollama...) with AI_PROVIDER=openai-compatible.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_NAME=
# false for services that support JSON mode but not JSON schemas
AI_JSON_SCHEMA=true
AI_MAX_RUNS_PER_HOUR=120

# ─── Email ───────────────────────────────────────────────────────────────
# Defaults to smtp when SMTP_URL is set, otherwise console (log emails; codes on screen in development).
EMAIL_PROVIDER=
SMTP_URL=
EMAIL_FROM="Case Manager <no-reply@example.com>"
# Sender name recipients see (e.g. your business name); overrides the name in EMAIL_FROM.
EMAIL_FROM_NAME=
DEV_MAILBOX=true

# ─── Payments ────────────────────────────────────────────────────────────
# Defaults to stripe when STRIPE_SECRET_KEY is set, otherwise the built-in test checkout (mock).
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Grow (formerly Meshulam): credit card, Bit, Apple Pay, Google Pay. Easiest: connect it in the app under
# Payments → Connect Grow (an admin enters userId + pageCode; stored encrypted). Or set them here.
# Once connected, Grow is used for all checkouts. Ask Grow support for sandbox/production identifiers.
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
# true = Grow sandbox (test cards, no real charges); false = production
GROW_SANDBOX=true
# Only for tests/special setups: override Grow's API base URL
GROW_API_URL=

# ─── File storage ────────────────────────────────────────────────────────
# local = encrypted files in .data/uploads; s3 = any S3-compatible bucket; database = encrypted in PostgreSQL;
# vercel-blob = Vercel Blob (default when BLOB_READ_WRITE_TOKEN is set). On Vercel the default is database.
STORAGE_PROVIDER=
STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=20
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Malware scanning via ClamAV (clamd). Without it, uploads are validated but not scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ─── Jobs ────────────────────────────────────────────────────────────────
# Protects POST /api/jobs/run (quote expiry + email outbox). Call it from cron.
CRON_SECRET=
# ...or run the same jobs inside the server every N minutes (0 = off).
JOBS_INTERVAL_MINUTES=0

# ─── Container ───────────────────────────────────────────────────────────
# Persistent data directory in the Docker image (uploads, embedded database).
DATA_DIR=/var/data

# Push notifications (Web Push). Optional: without keys the app generates a pair once and stores it encrypted.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://your-site (default: the app URL)
VAPID_SUBJECT=
# Tests only: extra push endpoint hosts (host:port) besides the browser push services
PUSH_EXTRA_HOSTS=

# WhatsApp (Meta Cloud API). Optional: an admin can connect it under Settings → Integrations instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into the Meta app's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Approved template name (languages "he" and "en")
WHATSAPP_TEMPLATE=case_update
# Tests only: a stand-in for Meta's Graph API (default https://graph.facebook.com/v23.0)
WHATSAPP_API_URL=

# Sign-in codes allowed per 15 minutes, per email address (default 5) and per IP address (default 30).
# Raise only on test servers.
OTP_MAX_PER_EMAIL=
OTP_MAX_PER_IP=
